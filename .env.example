# Copia este archivo como .env y rellena tu API key.
# Consíguela en https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Opcional ---------------------------------------------------------------
# Modelo de Claude (por defecto claude-opus-5). Ej.: claude-sonnet-5 es más barato.
# ALI_MODEL=claude-opus-5
# Esfuerzo al conversar (low | medium | high | xhigh | max). Más alto = piensa más, cuesta más.
# ALI_EFFORT=medium
# Esfuerzo al consolidar recuerdos al final de cada sesión.
# ALI_REFLECTION_EFFORT=high
# Búsqueda en internet para informarse y opinar (true/false).
# ALI_WEB_SEARCH=true
# Reintento automático en un modelo de respaldo si una petición es rechazada (true/false).
# ALI_FALLBACKS=true
# Dónde se guarda su memoria y personalidad (respáldala; ¡es Ali!).
# ALI_DATA_DIR=./data
# Carpeta de archivos a la que Ali tiene acceso.
# ALI_FILES_DIR=./data/archivos
# ADN de Ali (identidad base).
# ALI_PERSONA_FILE=./config/persona.toml
# Habilidades activas (separadas por comas). Puedes agregar módulos propios: mi_paquete.mi_skill
# ALI_SKILLS=memoria,personalidad,agenda,archivos,multimedia
# Que Ali salude al abrir (true/false).
# ALI_SALUDO=true
# Consolidar recuerdos cada N mensajes tuyos además de al salir (0 = sólo al salir).
# ALI_REFLECT_EVERY=30
# Mensajes de la conversación anterior que recuerda textualmente al iniciar.
# ALI_HISTORY_MESSAGES=20
# Recuerdos que le "vienen a la mente" en cada mensaje.
# ALI_MEMORIES_PER_TURN=5
